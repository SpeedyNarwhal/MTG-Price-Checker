#!/usr/bin/env python3
"""Strip Cursor attribution trailers injected into agent commits."""

from __future__ import annotations

import re
import sys
from pathlib import Path

_STRIP = re.compile(
    r"^(Co-authored-by:\s*Cursor\b|Made-with:\s*Cursor\b|Made with Cursor\b)",
    re.IGNORECASE,
)


def main() -> int:
    if len(sys.argv) < 2:
        return 0
    path = Path(sys.argv[1])
    original = path.read_text(encoding="utf-8")
    cleaned_lines = [line for line in original.splitlines(keepends=True) if not _STRIP.match(line)]
    path.write_text("".join(cleaned_lines), encoding="utf-8")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
