#!/bin/sh
# Strip Cursor attribution trailers injected into agent commits.
# Prefer `python` on Windows PATH; fall back to python3.
if command -v python >/dev/null 2>&1; then
  PY=python
elif command -v python3 >/dev/null 2>&1; then
  PY=python3
else
  exit 0
fi

"$PY" - "$1" <<'PY'
from __future__ import annotations

import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
strip = re.compile(
    r"^(Co-authored-by:\s*Cursor\b|Made-with:\s*Cursor\b|Made with Cursor\b)",
    re.IGNORECASE,
)
original = path.read_text(encoding="utf-8")
cleaned = "".join(line for line in original.splitlines(keepends=True) if not strip.match(line))
path.write_text(cleaned, encoding="utf-8")
PY
